# Telegram credentials are now entered through the web app (login page),
# not here. This file is only for non-secret settings.
PORT=3000
DB_PATH=./teledrive.db

# Required for a separately hosted frontend. Exact origins only, comma separated.
# Empty keeps same-origin/local Vite proxy access; it does not enable browser CORS.
# Example: https://your-project.vercel.app,https://drive.example.com
ALLOWED_ORIGINS=
